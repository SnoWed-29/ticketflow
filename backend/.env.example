NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Values for running the backend on the host. Docker Compose overrides these
# with the service names postgres, redis, keycloak, and meilisearch.
DATABASE_URL=postgresql://ticketflow:change-me@localhost:5432/ticketflow?schema=public
REDIS_URL=redis://:change-me@localhost:6379
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=change-me

# The issuer is public because it must exactly match the token's iss claim.
# JWKS may use a separate reachable URL; Compose uses the internal Keycloak URL.
KEYCLOAK_ISSUER_URL=http://localhost:8080/keycloak/realms/ticketflow
KEYCLOAK_JWKS_URL=http://localhost:8080/keycloak/realms/ticketflow/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=ticketflow-api
KEYCLOAK_ALLOWED_CLIENTS=ticketflow-frontend

OTEL_SERVICE_NAME=ticketflow-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
