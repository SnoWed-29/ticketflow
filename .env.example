# Runtime
NODE_ENV=development

# Public gateway and optional direct backend debugging
NGINX_PORT=8080
BACKEND_DIRECT_PORT=5000

# TicketFlow PostgreSQL
POSTGRES_DB=ticketflow
POSTGRES_USER=ticketflow
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=change-me
REDIS_PORT=6379

# Keycloak server and public issuer
KEYCLOAK_VERSION=26.7.0
KEYCLOAK_DIRECT_PORT=8081
KEYCLOAK_MANAGEMENT_PORT=9000
KEYCLOAK_PUBLIC_URL=http://localhost:8080/keycloak
KEYCLOAK_REALM=ticketflow
KEYCLOAK_AUDIENCE=ticketflow-api
KEYCLOAK_ALLOWED_CLIENTS=ticketflow-frontend

# Keycloak administrator and imported confidential API client
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_TICKETFLOW_API_SECRET=change-me

# Keycloak PostgreSQL
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me

# Search
MEILISEARCH_VERSION=v1.15
MEILISEARCH_PORT=7700
MEILISEARCH_MASTER_KEY=change-me

# Observability
PROMETHEUS_VERSION=v3.4.1
PROMETHEUS_PORT=9090
GRAFANA_VERSION=12.0.2
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
JAEGER_VERSION=1.70.0
JAEGER_UI_PORT=16686
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_OTLP_HTTP_PORT=4318
